{
  "expo": {
    "name": "EVRide",
    "slug": "evrides-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "scheme": "evride",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evride.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EVRide uses your location to set pickup points and update driver position."
      }
    },
    "android": {
      "package": "com.evride.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF9",
        "foregroundImage": "./assets/logo.jpg"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EVRide to access your photos for profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EVRide to use your location for pickup and driver updates."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.jpg",
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF9"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "tanzeel2754",
    "extra": {
      "apiBaseUrl": "https://evrides-exaabxfrcdefc9dh.southeastasia-01.azurewebsites.net",
      "router": {},
      "eas": {
        "projectId": "5686d84a-2a3c-4601-a88e-5b9be0ddcdb4"
      }
    }
  }
}
